{
  "name": "good-news-games",
  "version": "1.0.0",
  "private": true,
  "description": "Good News Games: cartoon games based on Gospel stories, packaged as an iOS and Android app with Capacitor.",
  "scripts": {
    "build": "node scripts/build-www.js",
    "sync": "npm run build && npx cap sync",
    "assets": "npx capacitor-assets generate --ios --android",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
